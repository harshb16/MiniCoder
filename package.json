{
  "name": "minicoder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent": "./bin/agent"
  },
  "scripts": {
    "start": "bun src/cli.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sandbox:build": "docker build -t minicoder-sandbox:v1 .",
    "smoke": "bun scripts/smoke.ts",
    "check:secrets": "bun scripts/check-secrets.ts"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "latest",
    "openai": "latest",
    "react": "latest",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.20.8",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "@types/react": "latest",
    "typescript": "latest"
  }
}
